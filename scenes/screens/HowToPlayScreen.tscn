[node name="RulesText" type="Label" parent="SafeArea/VBox/RulesCard"]
layout_mode = 2
theme_override_colors/font_color = Color(0.952941, 0.968627, 1, 1)
theme_override_font_sizes/font_size = 20
text = "• Beat the timer bar on every prompt before it expires.
• Response time starts at 1.80s and gets faster as you score!
• Classic: 3 lives. Wrong tap or timeout costs 1 life.
• 60s Rush: 60 seconds total. Mistakes cost 1 point (never below 0).
• Pausing or switching apps freezes your timer fairly."
autowrap_mode = 3

